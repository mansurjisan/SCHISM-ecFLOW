#!/bin/bash
%include <head.h>

PARSE_YAML="/lfs/h1/nos/estofs/noscrub/mansur.jisan/packages/SCHISM-ecFLOW/ush/parse_yaml.py"

# Get paths and configuration from config.yml
SCRIPT_DIR=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.script_dir")
WORK_DIR=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.work_dir")


# Function for error handling
handle_error() {
    local exit_code=$1
    local error_msg=$2
    if [ $exit_code -ne 0 ]; then
        ecflow_client --label=error "$error_msg"
        exit $exit_code
    fi
}

# Initialize conda
#source "${CONDA_PATH}" || handle_error $? "Failed to source conda.sh"

# Get simulation parameters from config
YEAR=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.year")
MONTH=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.month")
DAY=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.day")
HOUR=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.hour")
RNDAY=$(python ${PARSE_YAML} "${CONFIG_FILE}" "namelist.rnday")

# Create work directory if it doesn't exist
mkdir -p ${WORK_DIR} || handle_error $? "Failed to create work directory"

# Change to script directory
cd ${SCRIPT_DIR} || handle_error $? "Failed to change to script directory"

# Select script based on run type
if [ %SCHISM_RUN_TYPE% == "schism+wwm+atm" ]; then
    SCRIPT_NAME="gen_namelist_sch_wm_sf.py"
else
    SCRIPT_NAME="gen_namelist.py"
fi

# Run Python script with error handling

echo "Running namelist generation script..."

python $SCRIPT_NAME --year $YEAR --month $MONTH --day $DAY --hour $HOUR --rnday $RNDAY --workdir $WORK_DIR
handle_error $? "Failed to run namelist generation script"

# Check if param.nml was created in the work directory

if [ ! -f "${WORK_DIR}/param.nml" ]; then
    handle_error 1 "param.nml file not created in ${WORK_DIR}"
fi

echo "Namelist generation completed successfully"

ecflow_client --label=info "namelist generation complete"

%include <tail.h>
