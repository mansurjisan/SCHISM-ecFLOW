suite stofs_suite
  edit ECF_HOME '/home/mjisan/workflow'
  edit ECF_INCLUDE '/home/mjisan/workflow'
  edit STOFS_RUN_TYPE "$(yq -r .suite.stofs_run_type ${CONFIG_FILE})"
  edit STOFS_CLUSTER "$(yq -r .suite.stofs_cluster ${CONFIG_FILE})"
  edit CONFIG_FILE '/home/mjisan/workflow/config.yml'
  edit PREPROCESS "$(yq -r .suite.preprocess_dir ${CONFIG_FILE})"


family preprocess
    task gen_bctides_stofs
      edit ECF_SCRIPT '/home/mjisan/workflow/ecf/gen_bctides_stofs.ecf'
    task gen_namelist_stofs
      edit ECF_SCRIPT '/home/mjisan/workflow/ecf/gen_namelist_stofs.ecf'
    task gen_river_forcing
      edit ECF_SCRIPT '/home/mjisan/workflow/ecf/gen_river_forcing.ecf'
  endfamily
endsuite
