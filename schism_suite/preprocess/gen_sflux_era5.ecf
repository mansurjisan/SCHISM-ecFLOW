#!/bin/bash
%include <head.h>

# Get paths and configuration from config.yml
CONDA_PATH=$(yq -r '.environment.conda.path' "${CONFIG_FILE}")
CONDA_ENV=$(yq -r '.environment.conda.env_name' "${CONFIG_FILE}")
SCRIPT_DIR=$(yq -r '.sflux.script_dir' "${CONFIG_FILE}")
WORK_DIR=$(yq -r '.sflux.work_dir' "${CONFIG_FILE}")
HGRID_PATH=$(yq -r '.sflux.hgrid_path' "${CONFIG_FILE}")

# Function for error handling
handle_error() {
    local exit_code=$1
    local error_msg=$2
    if [ $exit_code -ne 0 ]; then
        ecflow_client --label=error "$error_msg"
        exit $exit_code
    fi
}

# Initialize conda
source "${CONDA_PATH}" || handle_error $? "Failed to source conda.sh"

# Activate conda environment
conda activate ${CONDA_ENV} || handle_error $? "Failed to activate conda environment"

# Get simulation parameters from config
YEAR=$(yq -r '.namelist.year' "${CONFIG_FILE}")
MONTH=$(yq -r '.namelist.month' "${CONFIG_FILE}")
DAY=$(yq -r '.namelist.day' "${CONFIG_FILE}")
RNDAY=$(yq -r '.sflux.rnday' "${CONFIG_FILE}")

# Create work directory if it doesn't exist
mkdir -p ${WORK_DIR} || handle_error $? "Failed to create work directory"

# Change to script directory
cd ${SCRIPT_DIR} || handle_error $? "Failed to change to script directory"

# Run Python script with error handling
echo "Running sflux generation script..."
python gen_sflux_era51.py \
  --year $YEAR \
  --month $MONTH \
  --day $DAY \
  --rnday $RNDAY \
  --hgrid $HGRID_PATH \
  --outdir $WORK_DIR
handle_error $? "Failed to run sflux generation script"

# Check if output files exist (assuming sflux files are created)
for iday in $(seq 1 $RNDAY); do
    padded_day=$(printf "%%04d" $iday)  # Note the double %% for escaping
    if [ ! -f "${WORK_DIR}/sflux_air_1.${padded_day}.nc" ]; then
        handle_error 1 "Expected sflux file not found: sflux_air_1.${padded_day}.nc"
    fi
done

# Deactivate conda
conda deactivate

echo "Sflux generation completed successfully"
ecflow_client --label=info "ERA5 sflux generation complete"
%include <tail.h>
