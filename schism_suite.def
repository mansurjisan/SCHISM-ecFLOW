suite schism_suite

  edit ECF_HOME '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW'

  edit ECF_INCLUDE '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW'

  edit ECF_FILES '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW/jobs'

  edit SCHISM_RUN_TYPE "$(yq -r .suite.schism_run_type ${CONFIG_FILE})"

  edit SCHISM_CLUSTER "$(yq -r .suite.schism_cluster ${CONFIG_FILE})"

  edit CONFIG_FILE '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW/config/config.yml'

  edit PREPROCESS "$(yq -r .suite.preprocess_dir ${CONFIG_FILE})"


family preprocess

    task gen_manning
      edit ECF_SCRIPT '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW/ecf/gen_manning.ecf'

    task gen_sflux_era5
      edit ECF_SCRIPT '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW/ecf/gen_sflux_era5.ecf'

   task gen_bctides
      edit ECF_SCRIPT '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW/ecf/gen_bctides.ecf'

   task gen_namelist
      edit ECF_SCRIPT '/work/noaa/nosofs/mjisan/SCHISM-ecFLOW/ecf/gen_namelist.ecf'

  endfamily
endsuite
