suite schism_suite

  edit ECF_HOME '/lfs/h1/nos/estofs/noscrub/mansur.jisan/packages/SCHISM-ecFLOW'

  edit ECF_INCLUDE '/lfs/h1/nos/estofs/noscrub/mansur.jisan/packages/SCHISM-ecFLOW'

  edit ECF_FILES '/lfs/h1/nos/estofs/noscrub/mansur.jisan/packages/SCHISM-ecFLOW/jobs'

  edit PARSE_YAML '/lfs/h1/nos/estofs/noscrub/mansur.jisan/packages/SCHISM-ecFLOW/ush/parse_yaml.py'
  
  edit SCHISM_RUN_TYPE "$(python ${PARSE_YAML} ${CONFIG_FILE} 'suite.schism_run_type')"

  edit SCHISM_CLUSTER "$(python ${PARSE_YAML} ${CONFIG_FILE} 'suite.schism_cluster')"

  edit PREPROCESS "$(python ${PARSE_YAML} ${CONFIG_FILE} 'suite.preprocess_dir')"
  


family preprocess

